{
  "activities": [
    {
      "name": "copy_landing_to_bronze",
      "type": "Copy",
      "dependsOn": [],
      "policy": {
        "timeout": "0.12:00:00",
        "retry": 2,
        "retryIntervalInSeconds": 30,
        "secureOutput": false,
        "secureInput": false
      },
      "typeProperties": {
        "source": {
          "type": "BinarySource",
          "storeSettings": {
            "type": "AzureBlobFSReadSettings",
            "recursive": false
          },
          "formatSettings": {
            "type": "BinaryReadSettings"
          }
        },
        "sink": {
          "type": "BinarySink",
          "storeSettings": {
            "type": "AzureBlobFSWriteSettings"
          }
        },
        "enableStaging": false
      },
      "inputs": [
        {
          "referenceName": "ds_adls_binary",
          "type": "DatasetReference",
          "parameters": {
            "folder_path": {
              "value": "@pipeline().parameters.source_folder",
              "type": "Expression"
            },
            "file_name": {
              "value": "@pipeline().parameters.file_name",
              "type": "Expression"
            }
          }
        }
      ],
      "outputs": [
        {
          "referenceName": "ds_adls_binary",
          "type": "DatasetReference",
          "parameters": {
            "folder_path": {
              "value": "@pipeline().parameters.target_folder",
              "type": "Expression"
            },
            "file_name": {
              "value": "@pipeline().parameters.file_name",
              "type": "Expression"
            }
          }
        }
      ]
    }
  ],
  "parameters": {
    "source_folder": {
      "type": "String",
      "defaultValue": "landing/orders"
    },
    "file_name": {
      "type": "String",
      "defaultValue": "olist_orders_dataset.csv"
    },
    "target_folder": {
      "type": "String",
      "defaultValue": "bronze/orders"
    }
  },
  "annotations": [
    "Reusable Landing-to-Bronze binary ingestion"
  ]
}
